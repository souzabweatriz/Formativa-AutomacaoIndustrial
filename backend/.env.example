PORT=3000
OPC_ENDPOINT=opc.tcp://169.254.171.199:4840
OPC_NAMESPACE_URI=http://vue

# These are the numeric NodeIds currently verified in this PLC project.
OPC_NODE_VERMELHAS=ns=4;i=3
OPC_NODE_VERDES=ns=4;i=4
OPC_NODE_AMARELAS=ns=4;i=5
OPC_NODE_TOTAL=ns=4;i=6

# Set this after adding and publishing the machine-state variable in the PLC.
# Example format only; replace it with the real NodeId from the OPC UA server.
OPC_NODE_ESTADO=
